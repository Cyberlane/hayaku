      "operation": "replace",
      "path": "calc/config.txt",
      "before": "ready\n",
      "after": "broken\n",
      "expected_failures": ["example.invalid/hayaku-faults/calc/TestResource"]
    },
    {
      "id": "startup-side-effect",
      "operation": "replace",
      "path": "startup/state.go",
